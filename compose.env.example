# Docker Compose development settings. Copy to .env only if it does not exist;
# otherwise add these variables to your existing .env without replacing it.
# Choose your own password; this is separate from your host PostgreSQL password.
COMPOSE_DB_PASSWORD='replace-with-your-own-local-docker-password'
FRONTEND_PORT=5173
BACKEND_PORT=8080
MAILPIT_PORT=8025
# Match the host/port you use in your browser (localhost and 127.0.0.1 are different cookie origins).
PASSWORD_RESET_URL=http://localhost:5173/reset-password
