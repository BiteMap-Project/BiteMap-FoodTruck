# Copy to .env and replace the password with your own local database password.
# Load .env into your shell before running Maven; Spring Boot does not load it automatically.
DB_URL=jdbc:postgresql://localhost:5432/bitemap
DB_USERNAME=bitemap
DB_PASSWORD='replace-with-your-local-password'

# Required when running without the dev profile. Generate a random shared secret
# (for example: openssl rand -hex 32); use the same value on every backend instance.
# Local Docker Compose uses the dev profile and a development-only fallback key.
# AUTH_RATE_LIMIT_SECRET='paste-your-generated-secret-here'
